<Window x:Class="InternetTrafficController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Internet Traffic Controller"
        Width="1120"
        Height="800"
        MinWidth="1000"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="White"
        FontFamily="Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- Classic compact controls -->

        <Style TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#F4F4F4"/>
            <Setter Property="BorderBrush" Value="#A9A9A9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C8C8C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B8B8B8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,8,10,10"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <!-- White outer border -->
    <Border Background="White"
            BorderBrush="White"
            BorderThickness="2">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="42"/>
            </Grid.RowDefinitions>

            <!-- MENU -->
            <Menu Grid.Row="0"
                  Background="White"
                  Padding="6,2">

                <MenuItem Header="Device"/>
                <MenuItem Header="Options"/>
                <MenuItem Header="Help"/>

            </Menu>

            <Border Grid.Row="1"
                    Background="#E2E2E2"/>

            <!-- MAIN CONTENT -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="#FAFAFA">

                <Grid Margin="12">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ADAPTER SELECTOR -->
                    <Border Grid.Row="0"
                            BorderBrush="#D6D6D6"
                            BorderThickness="1"
                            CornerRadius="5"
                            Background="#FCFCFC"
                            Padding="14"
                            Margin="0,0,0,10">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="AdapterComboBox"
                                      Grid.Column="0"
                                      SelectedIndex="0"
                                      Margin="0,0,12,0">
                                <ComboBoxItem Content="Loading network adapters..."/>
                            </ComboBox>

                            <CheckBox x:Name="EditAdapterCheckBox"
                                      Grid.Column="1"
                                      Content="Edit"
                                      VerticalAlignment="Center"
                                      Margin="0,0,4,0"/>

                        </Grid>

                    </Border>

                    <!-- DRIVER / MORE INFORMATION -->
                    <Grid Grid.Row="1"
                          Margin="0,0,0,10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT PANEL -->
                        <Border Grid.Column="0"
                                BorderBrush="#D6D6D6"
                                BorderThickness="1"
                                CornerRadius="5"
                                Background="#FCFCFC"
                                Padding="14"
                                Margin="0,0,10,0">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="45"/>
                                    <RowDefinition Height="45"/>
                                    <RowDefinition Height="45"/>
                                    <RowDefinition Height="45"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0"
                                       Grid.Column="0"
                                       Content="Driver:"/>

                                <TextBox x:Name="DriverTextBox"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         IsReadOnly="True"
                                         Text="-"/>

                                <TextBlock Grid.Row="0"
                                           Grid.RowSpan="2"
                                           Grid.Column="2"
                                           Text="➜"
                                           Foreground="#00B820"
                                           FontSize="44"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <ComboBox x:Name="DriverActionComboBox"
                                          Grid.Row="0"
                                          Grid.Column="3">
                                    <ComboBoxItem Content="Current Adapter"/>
                                </ComboBox>

                                <Label Grid.Row="1"
                                       Grid.Column="0"
                                       Content="Provider:"/>

                                <TextBox x:Name="ProviderTextBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         IsReadOnly="True"
                                         Text="-"/>

                                <Label Grid.Row="2"
                                       Grid.Column="0"
                                       Content="Date:"/>

                                <TextBox x:Name="DriverDateTextBox"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         IsReadOnly="True"
                                         Text="-"/>

                                <Label Grid.Row="3"
                                       Grid.Column="0"
                                       Content="Version:"/>

                                <TextBox x:Name="DriverVersionTextBox"
                                         Grid.Row="3"
                                         Grid.Column="1"
                                         IsReadOnly="True"
                                         Text="-"/>

                                <Button x:Name="ReinstallDriverButton"
                                        Grid.Row="2"
                                        Grid.RowSpan="2"
                                        Grid.Column="3"
                                        Content="Refresh Adapter"
                                        Click="ReinstallDriverButton_Click"
                                        FontSize="16"
                                        BorderBrush="#2086C8"
                                        BorderThickness="1"/>

                            </Grid>

                        </Border>

                        <!-- MORE INFORMATION -->
                        <Border Grid.Column="1"
                                BorderBrush="#D6D6D6"
                                BorderThickness="1"
                                CornerRadius="5"
                                Background="#FCFCFC"
                                Padding="18">

                            <StackPanel>

                                <TextBlock Text="More Information"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,12"/>

                                <TextBlock Margin="0,4">
                                    <Hyperlink x:Name="AdapterPropertiesLink"
                                               Click="AdapterPropertiesLink_Click">
                                        View Adapter Properties
                                    </Hyperlink>
                                </TextBlock>

                                <TextBlock Margin="0,4">
                                    <Hyperlink x:Name="WindowsNetworkSettingsLink"
                                               Click="WindowsNetworkSettingsLink_Click">
                                        Windows Network Settings
                                    </Hyperlink>
                                </TextBlock>

                                <TextBlock Margin="0,4">
                                    <Hyperlink x:Name="DeviceManagerLink"
                                               Click="DeviceManagerLink_Click">
                                        Device Manager
                                    </Hyperlink>
                                </TextBlock>

                                <TextBlock Margin="0,4">
                                    <Hyperlink x:Name="NetworkHelpLink"
                                               Click="NetworkHelpLink_Click">
                                        Network Adapter Help
                                    </Hyperlink>
                                </TextBlock>

                            </StackPanel>

                        </Border>

                    </Grid>

                    <!-- ADAPTER INFORMATION -->
                    <GroupBox Grid.Row="2"
                              Header="Adapter Information"
                              Margin="0,0,0,10">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="43"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0"
                                   Grid.Column="0"
                                   Content="Status:"/>

                            <TextBox x:Name="StatusTextBox"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     IsReadOnly="True"
                                     Text="-"/>

                            <Label Grid.Row="1"
                                   Grid.Column="0"
                                   Content="IPv4 Address:"/>

                            <TextBox x:Name="IPv4TextBox"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     IsReadOnly="True"
                                     Text="-"/>

                            <Label Grid.Row="2"
                                   Grid.Column="0"
                                   Content="IPv6 Address:"/>

                            <TextBox x:Name="IPv6TextBox"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     IsReadOnly="True"
                                     Text="-"/>

                            <Label Grid.Row="3"
                                   Grid.Column="0"
                                   Content="MAC Address:"/>

                            <TextBox x:Name="MacAddressTextBox"
                                     Grid.Row="3"
                                     Grid.Column="1"
                                     IsReadOnly="True"
                                     Text="-"/>

                            <Label Grid.Row="0"
                                   Grid.Column="2"
                                   Content="Link Speed:"/>

                            <TextBox x:Name="LinkSpeedTextBox"
                                     Grid.Row="0"
                                     Grid.Column="3"
                                     IsReadOnly="True"
                                     Text="-"/>

                            <Label Grid.Row="1"
                                   Grid.Column="2"
                                   Content="Media State:"/>

                            <TextBox x:Name="MediaStateTextBox"
                                     Grid.Row="1"
                                     Grid.Column="3"
                                     IsReadOnly="True"
                                     Text="-"/>

                            <Label Grid.Row="2"
                                   Grid.Column="2"
                                   Content="Gateway:"/>

                            <TextBox x:Name="GatewayTextBox"
                                     Grid.Row="2"
                                     Grid.Column="3"
                                     IsReadOnly="True"
                                     Text="-"/>

                            <Label Grid.Row="3"
                                   Grid.Column="2"
                                   Content="DNS Servers:"/>

                            <TextBox x:Name="DnsServersTextBox"
                                     Grid.Row="3"
                                     Grid.Column="3"
                                     IsReadOnly="True"
                                     Text="-"/>

                        </Grid>

                    </GroupBox>

                    <!-- LOWER PANELS -->
                    <Grid Grid.Row="3">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.1*"/>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="1.05*"/>
                        </Grid.ColumnDefinitions>

                        <!-- TRAFFIC -->
                        <GroupBox Grid.Row="0"
                                  Grid.Column="0"
                                  Header="Traffic Statistics (Real-Time)">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="155"/>
                                    <ColumnDefinition Width="155"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0"
                                       Grid.Column="0"
                                       Content="Download Speed:"/>

                                <TextBox x:Name="DownloadSpeedTextBox"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         IsReadOnly="True"
                                         Text="0.00 Mbps"/>

                                <ProgressBar x:Name="DownloadProgressBar"
                                             Grid.Row="0"
                                             Grid.Column="2"
                                             Height="28"
                                             Margin="10,5"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="0"/>

                                <Label Grid.Row="1"
                                       Grid.Column="0"
                                       Content="Upload Speed:"/>

                                <TextBox x:Name="UploadSpeedTextBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         IsReadOnly="True"
                                         Text="0.00 Mbps"/>

                                <ProgressBar x:Name="UploadProgressBar"
                                             Grid.Row="1"
                                             Grid.Column="2"
                                             Height="28"
                                             Margin="10,5"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="0"/>

                                <StackPanel Grid.Row="0"
                                            Grid.RowSpan="2"
                                            Grid.Column="3"
                                            Margin="8,0,0,0">

                                    <TextBlock Text="Total Downloaded:"
                                               Margin="0,5,0,0"/>

                                    <TextBlock x:Name="TotalDownloadedTextBlock"
                                               Text="0 B"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6"/>

                                    <TextBlock Text="Total Uploaded:"/>

                                    <TextBlock x:Name="TotalUploadedTextBlock"
                                               Text="0 B"
                                               FontWeight="Bold"/>

                                    <Button x:Name="ResetCountersButton"
                                            Content="Reset Counters"
                                            Height="32"
                                            Margin="0,5,0,0"
                                            Click="ResetCountersButton_Click"/>

                                </StackPanel>

                            </Grid>

                        </GroupBox>

                        <!-- PROFILE -->
                        <GroupBox Grid.Row="0"
                                  Grid.Column="1"
                                  Header="Profile">

                            <StackPanel>

                                <ComboBox x:Name="ProfileComboBox"
                                          SelectedIndex="0">
                                    <ComboBoxItem Content="Balanced"/>
                                    <ComboBoxItem Content="Gaming"/>
                                    <ComboBoxItem Content="Streaming"/>
                                    <ComboBoxItem Content="Maximum Throughput"/>
                                    <ComboBoxItem Content="Conservative"/>
                                </ComboBox>

                                <Button x:Name="ApplyProfileButton"
                                        Content="Apply Profile"
                                        Click="ApplyProfileButton_Click"/>

                                <Button x:Name="RestoreDefaultsButton"
                                        Content="Restore Defaults"
                                        Click="RestoreDefaultsButton_Click"/>

                            </StackPanel>

                        </GroupBox>

                        <!-- ADVANCED -->
                        <GroupBox Grid.Row="0"
                                  Grid.Column="2"
                                  Header="Advanced">

                            <StackPanel>

                                <Button Content="TCP/IP Settings"
                                        Click="TcpSettingsButton_Click"/>

                                <Button Content="MTU Settings"
                                        Click="MtuSettingsButton_Click"/>

                            </StackPanel>

                        </GroupBox>

                        <!-- DNS -->
                        <GroupBox Grid.Row="1"
                                  Grid.Column="0"
                                  Header="DNS Configuration">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="45"/>
                                    <RowDefinition Height="45"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0"
                                       Grid.Column="0"
                                       Content="Primary DNS:"/>

                                <TextBox x:Name="PrimaryDnsTextBox"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Text="1.1.1.1"/>

                                <Label Grid.Row="1"
                                       Grid.Column="0"
                                       Content="Secondary DNS:"/>

                                <TextBox x:Name="SecondaryDnsTextBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Text="8.8.8.8"/>

                                <StackPanel Grid.Row="0"
                                            Grid.RowSpan="2"
                                            Grid.Column="2"
                                            Margin="15,0,0,0">

                                    <ComboBox x:Name="DnsPresetComboBox"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="Cloudflare DNS"/>
                                        <ComboBoxItem Content="Google DNS"/>
                                        <ComboBoxItem Content="Quad9 DNS"/>
                                        <ComboBoxItem Content="Automatic (DHCP)"/>
                                        <ComboBoxItem Content="Custom"/>
                                    </ComboBox>

                                    <Button x:Name="ApplyDnsButton"
                                            Content="Apply DNS"
                                            HorizontalAlignment="Right"
                                            Width="130"
                                            Click="ApplyDnsButton_Click"/>

                                </StackPanel>

                            </Grid>

                        </GroupBox>

                        <!-- DIAGNOSTICS -->
                        <GroupBox Grid.Row="1"
                                  Grid.Column="1"
                                  Grid.ColumnSpan="2"
                                  Header="Diagnostics">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Row="0"
                                        Grid.Column="0"
                                        Content="Ping Test"
                                        Click="PingTestButton_Click"/>

                                <Button Grid.Row="0"
                                        Grid.Column="1"
                                        Content="DNS Test"
                                        Click="DnsTestButton_Click"/>

                                <Button Grid.Row="0"
                                        Grid.Column="2"
                                        Content="Gateway Test"
                                        Click="GatewayTestButton_Click"/>

                                <Button Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        Content="Open Command Prompt"
                                        Click="OpenCommandPromptButton_Click"/>

                            </Grid>

                        </GroupBox>

                    </Grid>

                </Grid>

            </ScrollViewer>

            <!-- STATUS BAR -->
            <Border Grid.Row="3"
                    Background="White"
                    BorderBrush="#D6D6D6"
                    BorderThickness="0,1,0,0">

                <Grid Margin="15,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusBarTextBlock"
                               Grid.Column="0"
                               Text="Ready."
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="AdministratorTextBlock"
                               Grid.Column="1"
                               Text="Checking..."
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                    <TextBlock Grid.Column="2"
                               Text="Version 1.0.0.0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>